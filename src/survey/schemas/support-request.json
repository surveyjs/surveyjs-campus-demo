{
  "title": "Student Support Request",
  "pages": [
    {
      "name": "request",
      "elements": [
        {
          "type": "dropdown",
          "name": "request_type",
          "title": "Request type",
          "isRequired": true,
          "choices": ["Academic Support", "Accessibility Support", "Financial Support", "Personal Support", "Technical Support"]
        },
        {
          "type": "dropdown",
          "name": "priority",
          "startWithNewLine": false,
          "title": "Priority",
          "isRequired": true,
          "choices": ["Low", "Normal", "High", "Urgent"],

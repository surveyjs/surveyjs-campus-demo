        },
        { "type": "comment", "name": "description", "title": "Request description", "isRequired": true, "rows": 4 },
        { "type": "comment", "name": "supporting_information", "title": "Supporting information", "rows": 3 }
      ]
    }
  ],
  "completeText": "Submit Request",
  "headerView": "basic"
}

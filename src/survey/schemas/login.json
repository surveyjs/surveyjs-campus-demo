{
  "title": "Campus Sign In",
  "pages": [
    {
      "name": "sign_in",
      "elements": [
        {
          "type": "dropdown",
          "name": "roster_user",
          "title": "Demo account",
          "description": "Choosing an account fills the username and password.",
          "placeholder": "Select an account...",
          "choicesByUrl": {
            "url": "/api/auth/roster",
            "valueName": "username",
            "titleName": "label"
          }
        },
        {
          "type": "text",
          "name": "username",
          "title": "Username",
          "isRequired": true,
          "placeholder": "e.g. sophie.wilson",
          "autocomplete": "username"
        },
        {
          "type": "text",
          "name": "password",
          "title": "Password",
          "description": "Every demo account uses the password demo1234.",
          "isRequired": true,
          "inputType": "password",
          "placeholder": "Enter the password",
          "autocomplete": "current-password"
        },
        {
          "type": "boolean",
          "name": "remember_me",
          "title": "Keep me signed in on this device",
          "titleLocation": "hidden",
          "displayMode": "checkbox"
        }
      ]
    }
  ],
  "triggers": [
    {
      "type": "copyvalue",
      "expression": "{roster_user} notempty",
      "fromName": "roster_user",
      "setToName": "username"
    },
    {
      "type": "setvalue",
      "expression": "{roster_user} notempty",
      "setToName": "password",
      "setValue": "demo1234"
    }
  ],
  "completeText": "Sign In",
  "headerView": "basic"
}
